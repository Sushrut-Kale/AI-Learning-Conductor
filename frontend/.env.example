# Frontend Environment Variables
# Copy this to .env.local and configure for your environment.
# NEVER commit .env.local to version control.

# Backend API base URL
# Development: leave empty (Vite proxy handles /api → localhost:8000)
# Production: set to your deployed backend URL, e.g. https://api.yourschool.edu.in
VITE_API_BASE_URL=

# Demo mode: true | false
# Should match backend DEMO_MODE setting
# When true, the UI shows a DEMO badge and demo-specific labels
VITE_DEMO_MODE=true

# Application environment: development | production
VITE_ENVIRONMENT=development
