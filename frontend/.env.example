# Frontend Environment Variables
# Copy this to .env.local and configure for your environment.
# NEVER commit .env.local to version control.

# Backend API base URL
# Development: leave empty (Vite proxy handles /api → http://localhost:8000)
# Production (Vercel / Netlify): set to your deployed backend URL:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
VITE_API_BASE_URL=

# Demo mode: true | false
# Should match backend DEMO_MODE setting
# When true, the UI shows a DEMO badge and demo-specific labels
VITE_DEMO_MODE=true

# Application environment: development | production
VITE_ENVIRONMENT=development
