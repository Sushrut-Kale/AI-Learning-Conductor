# =============================================================
# AI Learning Conductor — Backend Environment Configuration
# =============================================================
# For Render / Cloud deployment: Set these in Render Web Service Environment.
# For local development: Copy to backend/.env
# =============================================================

# Python version for Render runtime (Render reads PYTHON_VERSION or .python-version)
PYTHON_VERSION=3.13

# Deployment environment: development | production
ENVIRONMENT=development

# Demo mode: true | false
# When true: pre-seeded 30-student demo classroom is loaded on startup
# When false: starts with empty state; expects real school records
DEMO_MODE=true

# Gemini API Key (optional — system gracefully uses deterministic fallback if absent)
GEMINI_API_KEY=

# Gemini model to use
GEMINI_MODEL=gemini-2.5-flash

# CORS allowed origins (comma-separated, no trailing slashes)
# Development: http://localhost:3000,http://localhost:5173
# Production (Render): https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database URL
# Development: sqlite:///./data/ai_learning_conductor.db
# Production (Render Managed PostgreSQL): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/ai_learning_conductor.db

# Enable OpenAPI Swagger documentation at /docs (true | false)
ENABLE_DOCS=true

# AI Call Timeout (seconds)
AI_TIMEOUT_SECONDS=12

# Request size limit in MB
MAX_REQUEST_SIZE_MB=10

# Log Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
