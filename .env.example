# =============================================================
# AI Learning Conductor — Environment Configuration
# =============================================================
# Copy this file to .env (backend) and .env.local (frontend)
# and fill in the values for your environment.
# NEVER commit .env or .env.local with real secrets.
# =============================================================

# -----------------------------------
# BACKEND (.env in /backend)
# -----------------------------------

# Gemini API Key (required for AI-assisted summaries)
# If not provided, the system falls back to deterministic heuristics.
GEMINI_API_KEY=

# Gemini model to use (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Deployment environment: development | production
ENVIRONMENT=development

# Demo mode: true | false
# When true: pre-seeded 30-student demo data is loaded on startup
# When false: starts with empty state; real school records only
DEMO_MODE=true

# CORS allowed origins (comma-separated, no trailing slash)
# Development: http://localhost:3000
# Production: https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:3000

# Database URL
# Development (SQLite — zero config): sqlite:///./data/ai_learning_conductor.db
# Production (PostgreSQL): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/ai_learning_conductor.db

# Request size limit in MB (default: 10)
MAX_REQUEST_SIZE_MB=10

# -----------------------------------
# FRONTEND (.env.local in /frontend)
# -----------------------------------

# Backend API base URL
# Development: empty (uses Vite proxy)
# Production: https://your-backend-domain.com
VITE_API_BASE_URL=

# Demo mode UI flag — should match backend DEMO_MODE
VITE_DEMO_MODE=true

# Application environment
VITE_ENVIRONMENT=development
